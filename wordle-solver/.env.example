# Wordle API base (optional; derived from ENTRYPOINT when it ends with /daily or /random)
# WORDLE_API_BASE=https://wordle.votee.dev:8000
WORDLE_API_ENTRYPOINT=https://wordle.votee.dev:8000
WORDLE_API_TIMEOUT_SECONDS=10

# Puzzle + solver
WORDLE_MODE=random
WORDLE_WORD_LENGTH=8
# Loop daily puzzles for each size in [BEGIN, END]; skip size when first guess errors
WORDLE_SIZE_BEGIN=4
WORDLE_SIZE_END=8

# Random puzzle seeds (optional; both required; used when WORDLE_MODE=random)
WORDLE_SEED_BEGIN=1
WORDLE_SEED_END=10

# Available algorithms: brute_force, candidates
WORDLE_ALGORITHM=candidates
WORDLE_DICTIONARY_PATH=../data/words_alpha.txt
WORDLE_MAX_GUESSES=50
